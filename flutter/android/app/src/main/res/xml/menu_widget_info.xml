<?xml version="1.0" encoding="utf-8"?>
<!-- Taille cible 4x3, redimensionnable. Rafraîchissement système toutes les 3 h
     (le widget recharge aussi le menu lui-même quand son cache est périmé). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/menu_widget_description"
    android:initialLayout="@layout/menu_widget"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="110dp"
    android:previewLayout="@layout/menu_widget_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:updatePeriodMillis="10800000"
    android:widgetCategory="home_screen" />

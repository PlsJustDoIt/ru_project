<?xml version="1.0" encoding="utf-8"?>
<!-- Widget « Menu du RU » : en-tête (RU + actualiser), bandeau de jours,
     puis le menu en tableau catégorie | plats (ListView défilante). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/menu_widget_background"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/menu_widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="6dp"
            android:importantForAccessibility="no"
            android:src="@drawable/menu_widget_ic_restaurant" />

        <TextView
            android:id="@+id/menu_widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/menu_widget_default_title"
            android:textColor="@color/menu_widget_accent"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/menu_widget_refresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/menu_widget_refresh"
            android:padding="6dp"
            android:src="@drawable/menu_widget_ic_refresh" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/menu_widget_prev"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/menu_widget_prev"
            android:padding="4dp"
            android:src="@drawable/menu_widget_ic_prev" />

        <TextView
            android:id="@+id/menu_widget_day"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/menu_widget_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/menu_widget_next"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/menu_widget_next"
            android:padding="4dp"
            android:src="@drawable/menu_widget_ic_next" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/menu_widget_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/menu_widget_divider"
            android:dividerHeight="1dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/menu_widget_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="8dp"
            android:text="@string/menu_widget_loading"
            android:textColor="@color/menu_widget_text_secondary"
            android:textSize="13sp" />
    </FrameLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Ligne du tableau : catégorie (colonne gauche) | plats (colonne droite) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/menu_widget_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingTop="6dp"
    android:paddingEnd="6dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/menu_widget_row_category"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:layout_weight="0.36"
        android:textColor="@color/menu_widget_accent"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/menu_widget_row_dishes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.64"
        android:textColor="@color/menu_widget_text_primary"
        android:textSize="13sp" />
</LinearLayout>
